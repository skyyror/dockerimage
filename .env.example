# Copy file ini jadi ".env" lalu isi nilainya

# Token bot Telegram (dari @BotFather)
TELEGRAM_BOT_TOKEN=isi-token-bot-telegram-mu

# Image Docker "Ubuntu + SSH + Claude Code" yang sudah kamu build & push sendiri
# (lihat folder docker-image/ untuk Dockerfile-nya)
DOCKER_IMAGE=namamu/ubuntu-ssh-claude:latest
